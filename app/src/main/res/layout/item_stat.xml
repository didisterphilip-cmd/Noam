<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="20dp"
    android:paddingVertical="14dp">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@string/app_icon" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/gate_text"
            android:textSize="16sp"
            tools:text="Instagram" />

        <TextView
            android:id="@+id/counts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/gate_text_muted"
            android:textSize="13sp"
            tools:text="Reached for 7 · went in 2 · turned back 5" />

        <!-- One measure: the share of reaching-for that was turned back. -->
        <LinearLayout
            android:id="@+id/bar"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="9dp"
            android:background="@drawable/bar_track"
            android:orientation="horizontal">

            <View
                android:id="@+id/barFill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/bar_fill" />
        </LinearLayout>

        <TextView
            android:id="@+id/lastUsed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/gate_text_muted"
            android:textSize="12sp"
            tools:text="Last used 2 hours ago" />
    </LinearLayout>
</LinearLayout>
