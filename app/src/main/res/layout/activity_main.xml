<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gate_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/app_name"
            android:textColor="@color/gate_text"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/main_subtitle"
            android:textColor="@color/gate_text_muted"
            android:textSize="15sp" />

        <!-- Step 1: accessibility service -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Card.Gate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">

            <LinearLayout
                style="@style/CardContent.Gate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/CardTitle.Gate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/step_service_title" />

                <TextView
                    android:id="@+id/serviceBody"
                    style="@style/CardBody.Gate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/serviceButton"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/step_service_button" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Step 2: overlay permission -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Card.Gate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <LinearLayout
                style="@style/CardContent.Gate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/CardTitle.Gate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/step_overlay_title" />

                <TextView
                    android:id="@+id/overlayBody"
                    style="@style/CardBody.Gate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/overlayButton"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/step_overlay_button" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Step 3: the app list -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Card.Gate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <LinearLayout
                style="@style/CardContent.Gate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/CardTitle.Gate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/step_apps_title" />

                <TextView
                    android:id="@+id/appsBody"
                    style="@style/CardBody.Gate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/appsButton"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/step_apps_button" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- How a pass behaves -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Card.Gate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <LinearLayout
                style="@style/CardContent.Gate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/CardTitle.Gate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_title" />

                <TextView
                    style="@style/CardBody.Gate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pass_explainer" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/previewButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:text="@string/preview_button"
            android:textColor="@color/gate_accent" />
    </LinearLayout>
</ScrollView>
