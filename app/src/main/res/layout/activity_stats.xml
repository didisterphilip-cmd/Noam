<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gate_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/gate_background"
        android:title="@string/title_stats" />

    <!-- The three figures the whole page is about -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            style="@style/StatTile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                android:id="@+id/totalReached"
                style="@style/StatTileFigure"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/StatTileLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stats_total_reached" />
        </LinearLayout>

        <LinearLayout
            style="@style/StatTile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                android:id="@+id/totalEntered"
                style="@style/StatTileFigure"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/StatTileLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stats_total_entered" />
        </LinearLayout>

        <LinearLayout
            style="@style/StatTile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                android:id="@+id/totalTurnedBack"
                style="@style/StatTileFigure"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/StatTileLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stats_total_turned_back" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/emptyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="28dp"
        android:lineSpacingExtra="3dp"
        android:text="@string/stats_empty"
        android:textColor="@color/gate_text_muted"
        android:textSize="14sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/statList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp" />
</LinearLayout>
