<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Gate" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/gate_accent</item>
        <item name="android:windowBackground">@color/gate_background</item>
        <item name="android:statusBarColor">@color/gate_background</item>
        <item name="android:navigationBarColor">@color/gate_background</item>
        <item name="android:textColorPrimary">@color/gate_text</item>
        <item name="android:textColorSecondary">@color/gate_text_muted</item>
    </style>

    <style name="Theme.Gate.Fullscreen" parent="Theme.Gate">
        <item name="android:windowBackground">@color/gate_background</item>
        <item name="android:statusBarColor">@color/gate_background</item>
        <item name="android:navigationBarColor">@color/gate_background</item>
        <item name="android:windowAnimationStyle">@style/Animation.Gate</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="colorPrimary">@color/gate_accent</item>
        <item name="android:textColorPrimary">@color/gate_text</item>
        <item name="android:textColorSecondary">@color/gate_text_muted</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <style name="Card.Gate" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/gate_surface</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="CardContent.Gate">
        <item name="android:orientation">vertical</item>
        <item name="android:padding">18dp</item>
    </style>

    <style name="CardTitle.Gate">
        <item name="android:textColor">@color/gate_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CardBody.Gate">
        <item name="android:textColor">@color/gate_text_muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:layout_marginTop">6dp</item>
    </style>

    <style name="Animation.Gate" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@android:anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@android:anim/fade_out</item>
    </style>
</resources>
