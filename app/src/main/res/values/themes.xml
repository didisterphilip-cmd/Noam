<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Gate" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/gate_accent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowBackground">@color/gate_background</item>
        <item name="android:statusBarColor">@color/gate_background</item>
        <item name="android:navigationBarColor">@color/gate_background</item>
        <item name="android:textColorPrimary">@color/gate_text</item>
        <item name="android:textColorSecondary">@color/gate_text_muted</item>
    </style>

    <style name="Theme.Gate.Fullscreen" parent="Theme.Gate">
        <item name="android:windowBackground">@color/gate_background</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:statusBarColor">@color/gate_background</item>
        <item name="android:navigationBarColor">@color/gate_background</item>
        <item name="android:windowAnimationStyle">@style/Animation.Gate</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="colorPrimary">@color/gate_accent</item>
        <item name="android:textColorPrimary">@color/gate_text</item>
        <item name="android:textColorSecondary">@color/gate_text_muted</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <style name="Card.Gate" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/gate_surface</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="CardContent.Gate">
        <item name="android:orientation">vertical</item>
        <item name="android:padding">18dp</item>
    </style>

    <style name="CardTitle.Gate">
        <item name="android:textColor">@color/gate_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CardBody.Gate">
        <item name="android:textColor">@color/gate_text_muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:layout_marginTop">6dp</item>
    </style>

    <style name="StatTile">
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:paddingVertical">14dp</item>
    </style>

    <style name="StatTileFigure">
        <item name="android:textColor">@color/gate_text</item>
        <item name="android:textSize">34sp</item>
        <item name="android:fontFamily">sans-serif-light</item>
    </style>

    <style name="StatTileLabel">
        <item name="android:textColor">@color/gate_text_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="TaskChoice">
        <item name="android:textColor">@color/gate_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:minHeight">40dp</item>
    </style>

    <style name="TaskChoiceBody">
        <item name="android:textColor">@color/gate_text_muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:layout_marginStart">38dp</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>

    <style name="GateStat">
        <item name="android:textColor">@color/gate_text_muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Animation.Gate" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@android:anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@android:anim/fade_out</item>
    </style>
</resources>
